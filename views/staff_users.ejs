<!-- This is the staff users template. -->
<!-- It displays a list of all users and allows staff to block or unblock them. -->
<h1>Manage Users</h1>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% if (users && users.length) { %>
            <% users.forEach(function(user) { %>
                <tr>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.is_blocked ? 'Blocked' : 'Active' %></td>
                    <td>
                        <% if (user.is_blocked) { %>
                            <form action="/staff/users/unblock/<%= user.id %>" method="POST">
                                <button type="submit" class="btn btn-success">Unblock</button>
                            </form>
                        <% } else { %>
                            <form action="/staff/users/block/<%= user.id %>" method="POST">
                                <button type="submit" class="btn btn-danger">Block</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        <% } %>
    </tbody>
</table>
